<?xml version="1.0" encoding="UTF-8" ?>
<OpenSimDocument Version="40500">
	<Model name="default">
		<!--List of components that this component owns and serializes.-->
		<components />
		<!--Specify how accurate the resulting configuration of a model assembly should be. This translates to the number of significant digits in the resulting coordinate values. Therefore, if you require initial conditions accurate to four significant digits, use a minimum of 1e-4 as the accuracy.The default setting is 1e-9 as to satisfy the most stringent requirements by default. NOTE: Failure for a model to satisfy the assembly accuracy often indicates inconsistency in the constraints. For example, the feet are welded at locations measured to five significant digits while the model lacks dofs to change stance width, in which case it cannot achieve 1e-9 accuracy.-->
		<assembly_accuracy>1.0000000000000001e-09</assembly_accuracy>
		<!--The model's ground reference frame.-->
		<Ground name="ground">
			<!--List of components that this component owns and serializes.-->
			<components />
			<!--The geometry used to display the axes of this Frame.-->
			<FrameGeometry name="frame_geometry">
				<!--List of components that this component owns and serializes.-->
				<components />
				<!--Path to a Component that satisfies the Socket 'frame' of type Frame.-->
				<socket_frame></socket_frame>
				<!--Path to an output (channel) to satisfy the one-value Input 'transform' of type SimTK::Transform (description: The transform that positions the Geometry in Ground so it can be positioned. Note, either the Geometry is attached to a Frame OR the input transform can be supplied, but not both. ).-->
				<input_transform></input_transform>
				<!--Scale factors in X, Y, Z directions respectively.-->
				<scale_factors>0.20000000000000001 0.20000000000000001 0.20000000000000001</scale_factors>
				<!--Default appearance attributes for this Geometry-->
				<Appearance>
					<!--Flag indicating whether the associated Geometry is visible or hidden.-->
					<visible>true</visible>
					<!--The opacity used to display the geometry between 0:transparent, 1:opaque.-->
					<opacity>1</opacity>
					<!--The color, (red, green, blue), [0, 1], used to display the geometry. -->
					<color>1 1 1</color>
					<!--Visuals applied to surfaces associated with this Appearance.-->
					<SurfaceProperties>
						<!--The representation (1:Points, 2:Wire, 3:Shaded) used to display the object.-->
						<representation>3</representation>
					</SurfaceProperties>
				</Appearance>
				<!--The radius of the arrow-shaft used to display the frame.-->
				<display_radius>0.0040000000000000001</display_radius>
			</FrameGeometry>
			<!--List of geometry attached to this Frame. Note, the geometry are treated as fixed to the frame and they share the transform of the frame when visualized-->
			<attached_geometry />
			<!--Set of wrap objects fixed to this body that GeometryPaths can wrap over.This property used to be a member of Body but was moved up with the introduction of Frames.-->
			<WrapObjectSet name="wrapobjectset">
				<!--List of components that this component owns and serializes.-->
				<components />
				<objects />
				<groups />
			</WrapObjectSet>
		</Ground>
		<!--Acceleration due to gravity, expressed in ground.-->
		<gravity>0 -9.8066499999999994 0</gravity>
		<!--Credits (e.g., model author names) associated with the model.-->
		<credits>Frank Anderson, Peter Loan, Ayman Habib, Ajay Seth, Michael Sherman</credits>
		<!--Publications and references associated with the model.-->
		<publications>List of publications related to model...</publications>
		<!--Units for all lengths.-->
		<length_units>meters</length_units>
		<!--Units for all forces.-->
		<force_units>N</force_units>
		<!--List of bodies that make up this model.-->
		<BodySet name="bodyset">
			<!--List of components that this component owns and serializes.-->
			<components />
			<objects />
			<groups />
		</BodySet>
		<!--List of joints that connect the bodies.-->
		<JointSet name="jointset">
			<!--List of components that this component owns and serializes.-->
			<components />
			<objects />
			<groups />
		</JointSet>
		<!--Controllers that provide the control inputs for Actuators.-->
		<ControllerSet name="controllerset">
			<!--List of components that this component owns and serializes.-->
			<components />
			<objects />
			<groups />
		</ControllerSet>
		<!--Constraints in the model.-->
		<ConstraintSet name="constraintset">
			<!--List of components that this component owns and serializes.-->
			<components />
			<objects />
			<groups />
		</ConstraintSet>
		<!--Forces in the model (includes Actuators).-->
		<ForceSet name="forceset">
			<!--List of components that this component owns and serializes.-->
			<components />
			<objects />
			<groups />
		</ForceSet>
		<!--Markers in the model.-->
		<MarkerSet name="markerset">
			<!--List of components that this component owns and serializes.-->
			<components />
			<objects />
			<groups />
		</MarkerSet>
		<!--Geometry to be used in contact forces.-->
		<ContactGeometrySet name="contactgeometryset">
			<!--List of components that this component owns and serializes.-->
			<components />
			<objects />
			<groups />
		</ContactGeometrySet>
		<!--Probes in the model.-->
		<ProbeSet name="probeset">
			<!--List of components that this component owns and serializes.-->
			<components />
			<objects />
			<groups />
		</ProbeSet>
		<!--Additional components in the model.-->
		<ComponentSet name="componentset">
			<!--List of components that this component owns and serializes.-->
			<components />
			<objects />
			<groups />
		</ComponentSet>
		<!--Visual preferences for this model.-->
		<ModelVisualPreferences name="modelvisualpreferences">
			<!--Model display preferences-->
			<ModelDisplayHints>
				<!--Flag to indicate whether or not to show wrap geometry, default to true.-->
				<show_wrap_geometry>true</show_wrap_geometry>
				<!--Flag to indicate whether or not to show contact geometry, default to true.-->
				<show_contact_geometry>true</show_contact_geometry>
				<!--Flag to indicate whether or not to show path geometry for forces and actuators, default to true.-->
				<show_path_geometry>true</show_path_geometry>
				<!--Flag to indicate whether or not to show points along path are shown, default to true.-->
				<show_path_points>true</show_path_points>
				<!--Flag to indicate whether or not to show markers, default to true.-->
				<show_markers>true</show_markers>
				<!--Color is RGB, each components is in the range [0, 1], default to pink.-->
				<marker_color>1 0.59999999999999998 0.80000000000000004</marker_color>
				<!--Flag to indicate whether or not to show frames, default to false.-->
				<show_frames>false</show_frames>
				<!--Flag to indicate whether or not to show labels, default to false.-->
				<show_labels>false</show_labels>
				<!--Flag to indicate whether or not to show forces, default to true.-->
				<show_forces>true</show_forces>
				<!--Flag to indicate whether or not to show debug geometry, default to false.-->
				<show_debug_geometry>false</show_debug_geometry>
			</ModelDisplayHints>
		</ModelVisualPreferences>
	</Model>
</OpenSimDocument>
